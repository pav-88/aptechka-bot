{
  "name": "aptechka-bot",
  "version": "1.0.0",
  "description": "Telegram бот для управления домашней аптечкой",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:pg": "prisma migrate dev --name init --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "setup": "npm run prisma:migrate && npm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "telegram",
    "bot",
    "medicine",
    "aptechka"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.35.6",
    "node-cron": "^3.0.3",
    "openai": "^7.3.0",
    "prisma": "^6.19.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "vitest": "^3.0.9"
  }
}
