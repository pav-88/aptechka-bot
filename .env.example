# ===== Обязательные =====
BOT_TOKEN=your_bot_token_here

# ===== База данных =====
# Для Railway: PostgreSQL подключается автоматически — Railway сам пропишет DATABASE_URL
# Для локальной разработки: замени provider в prisma/schema.prisma на sqlite и укажи:
# DATABASE_URL="file:./dev.db"
DATABASE_URL="file:./dev.db"

# ===== AI (опционально) =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===== Логирование =====
LOG_LEVEL=INFO