# ===== Обязательные =====
BOT_TOKEN=your_bot_token_here

# ===== База данных =====
# Локально (SQLite):
DATABASE_URL="file:./dev.db"

# На Railway: PostgreSQL подключается автоматически — Railway сам пропишет DATABASE_URL
# Ничего менять не нужно

# ===== AI (опционально) =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===== Логирование =====
LOG_LEVEL=INFO