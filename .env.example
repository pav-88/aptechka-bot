# ===== Обязательные =====
BOT_TOKEN=your_bot_token_here

# ===== База данных =====
# Провайдер: sqlite (локально) или postgresql (Railway/production)
DATABASE_PROVIDER=sqlite

# SQLite (локально):
DATABASE_URL="file:./dev.db"

# PostgreSQL (Railway): Railway сам пропишет DATABASE_URL
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:password@host:5432/aptechka"

# ===== AI (опционально) =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===== Логирование =====
LOG_LEVEL=INFO